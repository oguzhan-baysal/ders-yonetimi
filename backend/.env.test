# Test Ortamı MongoDB Bağlantısı
# Test ortamında MongoDB Memory Server kullandığımız için bu değer kullanılmayacak
# Ancak yine de tanımlıyoruz çünkü uygulama bu değeri bekliyor olabilir
MONGODB_URI=mongodb://localhost:27017/test_db

# JWT (JSON Web Token) Ayarları
JWT_SECRET=test_jwt_secret_key
JWT_EXPIRES_IN=1h

# Sunucu Portu
PORT=5001

# CORS Ayarları
CORS_ORIGIN=http://localhost:3000

# Loglama Seviyesi
LOG_LEVEL=debug

# Test Ortamı Bayrağı
NODE_ENV=test